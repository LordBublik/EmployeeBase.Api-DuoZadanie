@page "/register"
@layout AuthLayout
@rendermode InteractiveServer
@inject EmployeeBase.Client.Managers.AuthManager AuthManager
@inject NavigationManager NavigationManager

<PageTitle>Регистрация</PageTitle>

<div class="auth-card">
        <h3>Регистрация</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="mb-3">
            <label class="form-label">Отображаемое имя</label>
            <input @bind="nameToShow" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Логин</label>
            <input @bind="login" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Пароль</label>
            <input @bind="password" class="form-control" type="password" />
        </div>

        <div class="mb-3">
            <label class="form-label">Повтор пароля</label>
            <input @bind="confirmPassword" class="form-control" type="password" />
        </div>

        <button class="btn btn-primary w-100" @onclick="HandleRegister">Зарегистрироваться</button>

        <p class="mt-3 mb-0">
            Уже есть аккаунт? <a href="/">Войти</a>
        </p>
</div>

@code {
    private string nameToShow = "";
    private string login = "";
    private string password = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private string successMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";

        var request = new RegisterRequestDto
        {
            NameToShow = nameToShow,
            Login = login,
            Password = password,
            ConfirmPassword = confirmPassword
        };

        var (success, message) = await AuthManager.RegisterAsync(request);

        if (success)
        {
            successMessage = message + " Переход ко входу через 2 секунды...";
            nameToShow = "";
            login = "";
            password = "";
            confirmPassword = "";

            await Task.Delay(2000);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = message;
        }
    }
}