@page "/employees"
@layout MainLayout
@rendermode InteractiveServer
@inject EmployeeBase.Client.Managers.EmployeeManager EmployeeManager
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Сотрудники</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded">
        <h2 class="mb-0">Список сотрудников</h2>
        <div class="d-flex align-items-center gap-3">
            @if (canEdit)
            {
                <button class="btn btn-success" @onclick="OpenCreateForm">+ Добавить сотрудника</button>
            }
            <div class="text-end">
                <div class="fw-bold">@userName</div>
                <small class="text-muted">@userRole</small>
            </div>
            <button class="btn btn-outline-danger" @onclick="Logout">Выйти</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(formError)) { <div class="alert alert-danger">@formError</div> }
    @if (!string.IsNullOrEmpty(formSuccess)) { <div class="alert alert-success">@formSuccess</div> }

    <!-- ПОИСК И ФИЛЬТР ПО РОЛИ -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Поиск по ФИО</label>
                    <input @bind="searchQuery" @bind:event="oninput" class="form-control" 
                           placeholder="Введите фамилию или часть имени..." 
                           @onkeydown="HandleSearchKeyDown" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Фильтр по роли</label>
                    <select @bind="selectedRoleId" class="form-select">
                        <option value="0">Все роли</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary flex-fill" @onclick="ApplyFilters">Найти</button>
                        <button class="btn btn-outline-secondary" @onclick="ClearFilters">Сбросить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ФОРМА -->
    @if (showForm)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">@(isEditing ? "Редактирование" : "Новый сотрудник")</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">ФИО *</label>
                        <input @bind="currentEmployee.FullName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Должность *</label>
                        <input @bind="currentEmployee.Profession" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">ID Отдела *</label>
                        <input @bind="currentEmployee.DepartmentId" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Телефон *</label>
                        <input @bind="currentEmployee.Phone" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email *</label>
                        <input @bind="currentEmployee.Email" class="form-control" />
                    </div>
                    @if (isAdmin)
                    {
                        <div class="col-md-4">
                            <label class="form-label">ID Роли</label>
                            <input @bind="currentEmployee.RoleId" class="form-control" type="number" min="1" />
                        </div>
                    }
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveEmployee">Сохранить</button>
                    <button class="btn btn-secondary" @onclick="CloseForm">Отмена</button>
                </div>
            </div>
        </div>
    }

    <!-- ТАБЛИЦА -->
    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2">Загрузка...</p></div>
    }
    else if (pagedResult.Items.Count == 0)
    {
        <div class="alert alert-info text-center">
            Сотрудники не найдены.
            @if (canEdit && string.IsNullOrEmpty(searchQuery) && selectedRoleId == 0)
            {
                <div class="mt-2">
                    <button class="btn btn-success" @onclick="OpenCreateForm">+ Добавить первого сотрудника</button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 5%">#</th>
                            <th style="width: 25%">ФИО</th>
                            <th style="width: 20%">Профессия</th>
                            <th style="width: 10%">ID Отдела</th>
                            <th style="width: 10%">Роль</th>
                            <th style="width: 15%">Телефон</th>
                            <th style="width: 15%">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in pagedResult.Items)
                        {
                            <tr>
                                <td class="text-muted">@((pagedResult.CurrentPage - 1) * 10 + pagedResult.Items.IndexOf(emp) + 1)</td>
                                <td><strong>@emp.FullName</strong></td>
                                <td>@emp.Profession</td>
                                <td>@emp.DepartmentId</td>
                                <td><span class="badge bg-secondary">@emp.RoleName</span></td>
                                <td>@emp.Phone</td>
                                <td>
                                    @if (canEdit)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditForm(emp)">Изменить</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEmployee(emp.Id)">Удалить</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ПАГИНАЦИЯ -->
        <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
            <button class="btn btn-outline-secondary" disabled="@(pagedResult.CurrentPage <= 1)" @onclick="() => LoadPage(pagedResult.CurrentPage - 1)">← Назад</button>
            <span>Страница <strong>@pagedResult.CurrentPage</strong> из @pagedResult.TotalPages</span>
            <button class="btn btn-outline-secondary" disabled="@(pagedResult.CurrentPage >= pagedResult.TotalPages)" @onclick="() => LoadPage(pagedResult.CurrentPage + 1)">Вперёд →</button>
        </div>
    }
</div>

@code {
    private PagedResultDto<EmployeeDto> pagedResult = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;
    private EmployeeDto currentEmployee = new();
    private string formError = "";
    private string formSuccess = "";
    private string searchQuery = "";
    private int selectedRoleId = 0; // 0 = "Все роли"
    private List<RoleDto> roles = new();
    
    private string userName = "";
    private string userRole = "";
    private bool isAdmin = false;
    private bool canEdit = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedUser = await JS.InvokeAsync<string>("localStorage.getItem", "currentUser");
            if (string.IsNullOrEmpty(savedUser)) 
            { 
                NavigationManager.NavigateTo("/"); 
                return; 
            }

            var userObj = System.Text.Json.JsonSerializer.Deserialize<UserInfoDto>(savedUser);
            if (userObj != null)
            {
                userName = userObj.NameToShow;
                isAdmin = userObj.RoleId == 1;
                canEdit = userObj.RoleId == 1 || userObj.RoleId == 2;
            }
            
            // Загружаем список ролей для фильтра
            roles = await EmployeeManager.GetRolesAsync();
            
            await LoadPage(1);
        }
    }

    private async Task LoadPage(int page, string? search = null, int? roleId = null)
    {
        isLoading = true;
        formError = "";
        formSuccess = "";
        StateHasChanged();
        pagedResult = await EmployeeManager.GetPageAsync(page, 10, search, roleId);
        isLoading = false;
        StateHasChanged();
    }

    private async Task ApplyFilters()
    {
        int? roleIdFilter = selectedRoleId > 0 ? selectedRoleId : null;
        await LoadPage(1, searchQuery, roleIdFilter);
    }

    private async Task ClearFilters()
    {
        searchQuery = "";
        selectedRoleId = 0;
        await LoadPage(1);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private void OpenCreateForm()
    {
        isEditing = false;
        currentEmployee = new EmployeeDto { DepartmentId = 1, RoleId = 3 };
        showForm = true;
    }

    private void OpenEditForm(EmployeeDto emp)
    {
        isEditing = true;
        currentEmployee = new EmployeeDto { 
            Id = emp.Id, FullName = emp.FullName, Profession = emp.Profession, 
            DepartmentId = emp.DepartmentId, Phone = emp.Phone, Email = emp.Email, RoleId = emp.RoleId 
        };
        showForm = true;
    }

    private void CloseForm() { showForm = false; currentEmployee = new(); }

    private async Task SaveEmployee()
    {
        formError = "";
        if (currentEmployee.DepartmentId <= 0) { formError = "Введите корректный ID отдела"; return; }

        var result = isEditing 
            ? await EmployeeManager.UpdateAsync(currentEmployee)
            : await EmployeeManager.CreateAsync(currentEmployee);

        if (result.Success)
        {
            formSuccess = result.Message;
            CloseForm();
            int? roleIdFilter = selectedRoleId > 0 ? selectedRoleId : null;
            await LoadPage(pagedResult.CurrentPage, searchQuery, roleIdFilter);
        }
        else { formError = result.Message; }
    }

    private async Task DeleteEmployee(int id)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Удалить сотрудника?");
        if (!confirm) return;

        var result = await EmployeeManager.DeleteAsync(id);
        if (result.Success)
        {
            int? roleIdFilter = selectedRoleId > 0 ? selectedRoleId : null;
            if (pagedResult.Items.Count == 1 && pagedResult.CurrentPage > 1)
            {
                await LoadPage(pagedResult.CurrentPage - 1, searchQuery, roleIdFilter);
            }
            else
            {
                await LoadPage(pagedResult.CurrentPage, searchQuery, roleIdFilter);
            }
        }
        else { formError = result.Message; }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "currentUser");
        await JS.InvokeVoidAsync("localStorage.removeItem", "currentLogin");
        NavigationManager.NavigateTo("/");
    }
}